<div class="d-flex gap-2 justify-content-end p-2">  <!-- réduit gap et padding -->
    <a href="/demandes/edit/reclamation/<%= reclamation.identifiant %>"
        class="badge bg-warning-subtle text-warning rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">  <!-- px-2 au lieu de px-1 -->
        <i class="bi bi-pen fs-5"></i> <span class="fs-6 px-1">Modifier</span>  <!-- fs-4 → fs-6 -->
    </a>

    <% if (reclamation.statut==="En attente" || reclamation.statut==="Rejetee" ) { %>
        <a href="/demandes/reclamation/valider/<%= reclamation.identifiant %>"
            class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-check2-circle fs-5"></i> <span class="fs-6 px-1">Valider</span>
        </a>
    <% } %>
    
    <% if (user && user.role==="Directeur" ) { %>
        <% if (reclamation.statut==="Validee" ) { %>
            <a href="/demandes/reclamation/upload/<%= reclamation.identifiant %>"
                class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
                <i class="bi-upload fs-5"></i><span class="fs-6 px-1">Uploader</span>
            </a>
        <% } %>
    <% } %>
    
    <% if (reclamation.statut==="Corrigee" ) { %>
        <a href="/demandes/reclamation/download/<%= reclamation.identifiant %>"
            class="badge bg-info-subtle text-info rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center" download>
            <i class="bi bi-download fs-5"></i><span class="fs-6 px-1">Telecharger</span>
        </a>
    <% } %>

    <% if (reclamation.statut==="En attente" || reclamation.statut==="Validee" ) { %>
        <a href="/demandes/reclamation/rejeter/<%= reclamation.identifiant %>"
            class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-x-circle fs-5"></i><span class="fs-6 px-1">Rejeter</span>
        </a>
    <% } %>

    <div class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 d-flex align-items-center">
        <button class="btn btn-link text-danger p-0 border-0 bg-danger-subtle d-flex align-items-center" 
                style="text-decoration: none;"
                data-bs-toggle="modal" 
                data-bs-target="#deleteModal-<%= reclamation.identifiant %>">
            <i class="bi bi-trash fs-5"></i>
            <span class="fs-6 px-1">Supprimer</span>
        </button>
    </div>

    <!-- Modal de suppression -->
    <div class="modal fade" id="deleteModal-<%= reclamation.identifiant %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmation de suppression</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer la demande <strong><%= reclamation.identifiant %></strong> ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form action="/demandes/reclamation/delete/<%= reclamation.identifiant %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>