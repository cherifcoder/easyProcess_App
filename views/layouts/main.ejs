<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Merriweather+Sans:ital,wght@0,300..800;1,300..800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/main-style.css">
  <title>
    <%=title%>
  </title>
</head>

<body>
  <div class="container-fluid">
    <div class="d-flex">
      <%-include("../partials/sidebar.ejs") %>
        <div class="main col-sm-11 p-0 bg-light">
          <div class=" navbar shadow-sm d-flex justify-content-between px-2 bg-white mb-lg-5 mb-sm-3">
            <div class="d-flex align-items-center">


            </div>
            <div class="d-flex align-items-center justify-content-center bg-light px-2 py-1 rounded-3">
              <i class="bi bi-person fs-1 bg-primary-subtle text-primary rounded-circle text-center align-items-center d-flex justify-content-center align-items-center mx-auto"
                style="width: 65px ;height: 65px; font-size: 3.5rem !important;"></i>
              <p class="text-primary fs-5 px-3 pt-3 fw-bolder">
                <%=user.prenom %>
                  <%=user.nom %>
              </p>
            </div>
          </div>

          <%-body%>
        </div>
    </div>

  </div>




  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const status = urlParams.get('status');

    if (status) {
      let title = '';
      let message = '';
      let icon = 'success'; // par défaut

      switch (status) {
        case 'successadm':
          title = 'Succès';
          message = 'Utilisateur enregistrée avec succès';
          break;
          case 'updatedadm':
          title = 'Succès';
          message = 'Utilisateur enregistrée avec succès';
          break;
          case 'deletedadm':
          title = 'Succès';
          message = 'Utilisateur enregistrée avec succès';
          break;

        case 'successetd':
          title = 'Succès';
          message = 'Etudiant enregistrée avec succès';
          break;
          case 'updatedetd':
          title = 'Succès';
          message = 'Utilisateur enregistrée avec succès';
          break;
          case 'deletedetd':
          title = 'Succès';
          message = 'Utilisateur enregistrée avec succès';
          break;

        case 'success':
          title = 'Succès';
          message = 'Demande enregistrée avec succès';
          break;
        case 'deleted':
          title = 'Supprimé';
          message = 'Demande supprimée avec succès';
          break;
        case 'updated':
          title = 'Modifié';
          message = 'Demande modifiée avec succès';
          break;
        case 'sent':
          title = 'Envoyée';
          message = 'Demande envoyée avec succès';
          break;
        case 'error':
          title = 'Erreur';
          message = 'Une erreur est survenue';
          icon = 'error';
          break;
          case 'validee':
          title = 'Succès';
          message = 'Demande validee avec succes';
          break;
          case 'rejetee':
          title = 'Succès';
          message = 'Demande rejetee avec succès';
          break;
      }

      Swal.fire({
        title: title,
        text: message,
        icon: icon,
        showConfirmButton: false,
        timer: 4000
      });
    }
  </script>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"></script>
</body>

</html>