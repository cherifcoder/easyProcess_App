<div class="container-fluid py-4 d-flex">

    <%- include("../../partials/filsDAriane.ejs") %>
    
</div>
<div class="d-flex gap-2 justify-content-end p-2">
    <!-- Bouton Modifier -->
    <a href="/demandes/edit/frequentation/<%= frequentation.identifiant %>"
        class="badge bg-warning-subtle text-warning rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
        <i class="bi bi-pen fs-5"></i> <span class="fs-6 px-1">Modifier</span>
    </a>

    <!-- Bouton Valider (si En attente ou Rejetee) -->
    <% if (frequentation.statut==="En attente" || frequentation.statut==="Rejetee" ) { %>
        <a href="/demandes/frequentation/valider/<%= frequentation.identifiant %>"
            class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-check2-circle fs-5"></i> <span class="fs-6 px-1">Valider</span>
        </a>
    <% } %>
    
    <!-- Bouton Signer (pour Directeur si Validee) -->
    <% if (user && user.role==="Directeur" ) { %>
        <% if (frequentation.statut==="Validee" ) { %>
            <a href="/demandes/frequentation/signer/<%= frequentation.identifiant %>"
                class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
                <i class="bi bi-file-earmark-text fs-5"></i><span class="fs-6 px-1">Signer</span>
            </a>
        <% } %>
    <% } %>
    
    <!-- Bouton Télécharger (si Signee) -->
    <% if (frequentation.statut==="Signee" ) { %>
        <a href="/demandes/frequentation/download/<%= frequentation.identifiant %>"
            class="badge bg-info-subtle text-info rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center" download>
            <i class="bi bi-download fs-5"></i><span class="fs-6 px-1">Telecharger</span>
        </a>
    <% } %>

    <!-- Bouton Rejeter (si En attente ou Validee) -->
    <% if (frequentation.statut==="En attente" || frequentation.statut==="Validee" ) { %>
        <a href="/demandes/frequentation/rejeter/<%= frequentation.identifiant %>"
            class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-x-circle fs-5"></i><span class="fs-6 px-1">Rejeter</span>
        </a>
    <% } %>

    <!-- Bouton Supprimer -->
    <div class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 d-flex align-items-center">
        <button class="btn btn-link text-danger p-0 border-0 bg-danger-subtle d-flex align-items-center" 
                style="text-decoration: none;"
                data-bs-toggle="modal" 
                data-bs-target="#deleteModal-<%= frequentation.identifiant %>">
            <i class="bi bi-trash fs-5"></i>
            <span class="fs-6 px-1 fw-bold">Supprimer</span>
        </button>
    </div>

    <!-- Modal de suppression -->
    <div class="modal fade" id="deleteModal-<%= frequentation.identifiant %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmation de suppression</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer la demande <strong><%= frequentation.identifiant %></strong> ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form action="/demandes/frequentation/delete/<%= frequentation.identifiant %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="bg-white px-4 py-4">
    <div class="row g-3">
        <div class="form-section-header border-info d-flex justify-content-between">
            <div class="">
                <h3 class="fw-bold text-primary">
                    <i class="bi bi-mortarboard-fill fs-1 me-2"></i>Informations sur l'étudiant
                </h3>
            </div>
        </div>

        <!-- Civilité -->
        <div class="col-md-1">
            <p class="form-label fw-semibold">Civilité :</p> 
            <span><%= frequentation.civilite %></span>
        </div>

        <!-- Nom complet -->
        <div class="col-md-3">
            <p class="form-label fw-semibold">Nom Complet :</p> 
            <span><%= frequentation.prenom %> <%= frequentation.nom %></span>
        </div>

        <!-- Filière -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Filière :</p> 
            <span><%= frequentation.filiere %></span>
        </div>

        <!-- Niveau -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Niveau :</p> 
            <span><%= frequentation.niveau %></span>
        </div>

        <!-- Promotion -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Promotion :</p> 
            <span><%= frequentation.promotion %></span>
        </div>

        <!-- Matricule -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Numéro matricule :</p> 
            <span><%= frequentation.matricule %></span>
        </div>
         <!-- Email -->
         <div class="col-md-2">
            <p class="form-label fw-semibold">Email</p> 
            <span><%= frequentation.email %></span>
        </div>
    </div>

    <hr class="mx-4">

    <div class="form-section bg-white">
        <div class="form-section-header border-info">
            <h3 class="fw-bold text-primary">
                <i class="bi bi-calendar-check fs-1 me-2"></i>Informations sur la demande de fréquentation
            </h3>
        </div>

        <div class="row">
            <!-- Identifiant -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Id :</p> 
                <span><%= frequentation.identifiant %></span>
            </div>

            <!-- Période -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Période :</p> 
                <span><%= frequentation.periode %></span>
            </div>

            <!-- Destination -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Destination :</p> 
                <span><%= frequentation.destination %></span>
            </div>

            <!-- Statut -->
            <div class="col-md-12 mt-3">
                <p class="form-label fw-semibold">Statut :</p> 
                <span class="badge 
                <%= frequentation.statut==='En attente' ? 'bg-primary-subtle text-primary' 
                : frequentation.statut==='Validee' ? 'bg-success-subtle text-success' 
                : frequentation.statut==='Signee' ? 'bg-success-subtle text-success'
                : frequentation.statut==='Corigee' ? 'bg-success-subtle text-success'
                : frequentation.statut==='Rejetee' ? 'bg-danger-subtle text-danger' : '' %>">
                    <%= frequentation.statut %>
                </span>
            </div>
        </div>
    </div>
</div>
