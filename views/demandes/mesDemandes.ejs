<%- include("../partials/filsDAriane.ejs") %>
<div class="container-fluid py-4">
  <h4 class="mt-5 mb-3 text-primary">Appliquer un filtre</h4>
  <div class="d-flex justify-content-between">
    <div class="mb-3 d-flex gap-3">
      <!-- Barre de recherche -->
      <form action="/demandes/list" method="GET" class="d-flex gap-2">
        <div class="col-md-3">
          <label class="form-label fw-semibold">Rechercher </label>
          <input type="text" name="q" class="form-control" placeholder="Rechercher par identifiant, filière, promotion...">
        </div>

        <!-- Filtre par type -->
        <div class="col-md-2">
          <label class="form-label fw-semibold">Demande </label>
          <select name="type" class="form-select">
            <option value="">Toutes</option>
            <option value="Diplome">Diplome</option>
            <option value="Frequentation">Frequentation</option>
            <option value="Reclamation">Reclamation</option>
            <option value="Recommandation">Recommandation</option>
            <option value="Releve">Releve</option>
            <option value="Stage">Stage</option>
          </select>
        </div>

        <!-- Filtre par statut -->
        <div class="col-md-2">
          <label class="form-label fw-semibold">Statut </label>
          <select name="statut" class="form-select">
            <option value="">Tous</option>
            <option value="En attente">En attente</option>
            <option value="Validee">Validee</option>
            <option value="Rejetee">Rejetee</option>
          </select>
        </div>

        <div class="col-md-1 d-flex flex-column justify-content-end">
          <button type="submit" class="btn btn-primary border-0">
            <i class="bi bi-search"></i>
          </button>
        </div>
      </form>
    </div>
    <div class="align-content-center">
        <%- include("../partials/btnAjout") %>
    </div>
  </div>
 
</div>

<div class="">
  <div class="form-section bg-white">
    <div class="form-section-header border-info">
      <h3 class="fw-bold text-primary">
        <i class="bi bi-folder2-open fs-1 me-2"></i>Mes demandes
      </h3>
    </div>

    <table class="table table-striped table-borderless table-hover table-responsive text-center border-0 shadow p-5">
      <thead>
        <tr>
          <th>No</th>
          <th>Type de demande</th>
          <th>Date</th>
          <th>ID Demande</th>
          <th>Filiere</th>
          <th>Niveau</th>
          <th>Promotion</th>
          <th>Statut</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% demandes.forEach((demande, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= demande.type %></td>
            <td><%= demande.createdAt.toLocaleDateString("fr-FR") %></td>
            <td><%= demande.identifiant %></td>
            <td><%= demande.filiere || "-" %></td>
            <td><%= demande.niveau || "-" %></td>
            <td><%= demande.promotion || "-" %></td>
            <td class="badge 
              <%= demande.statut==='En attente' ? 'bg-info-subtle text-info' :
                  demande.statut==='Validee' ? 'bg-success-subtle text-success' :
                  demande.statut==='Rejetee' ? 'bg-danger-subtle text-danger' : '' %>">
              <%= demande.statut %>
            </td>
            <td>
              <a href="/demandes/<%= demande.type %>/view/<%= demande.identifiant %>" 
                 class="badge bg-primary-subtle text-primary rounded-3 px-1 py-1">
                <i class="bi bi-eye fs-4"></i>
              </a>
              <a href="/demandes/<%= demande.type %>/edit/<%= demande.identifiant %>" 
                 class="badge bg-warning-subtle text-warning rounded-3 px-1 py-1">
                <i class="bi bi-pen fs-4"></i>
              </a>
              <a href="/demandes/<%= demande.type %>/delete/<%= demande.identifiant %>" 
                 class="badge bg-danger-subtle text-danger rounded-3 px-1 py-1">
                <i class="bi bi-trash fs-4"></i>
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

