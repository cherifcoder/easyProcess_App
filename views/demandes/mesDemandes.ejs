<%- include("../partials/filsDAriane.ejs") %>
<div class="container-fluid py-4">
  
  <div class="d-flex justify-content-between">
    <div class="mb-3 d-flex gap-3">
      <!-- Barre de recherche -->
   
    </div>
    <div class="align-content-center">
        <%- include("../partials/btnAjout") %>
    </div>
  </div>
 
</div>

<div class="">
  <div class="form-section bg-white">
    <div class="form-section-header border-info">
      <h3 class="fw-bold text-primary">
        <i class="bi bi-folder2-open fs-1 me-2"></i>Mes demandes
      </h3>
    </div>

    <table class="table table-striped table-borderless table-hover table-responsive text-center border-0 shadow p-5">
      <thead>
        <tr>
          <th>No</th>
          <th>Type de demande</th>
          <th>Date</th>
          <th>ID Demande</th>
          <th>Filiere</th>
          <th>Niveau</th>
          <th>Promotion</th>
          <th>Statut</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% demandes.forEach((demande, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= demande.type %></td>
            <td><%= demande.createdAt.toLocaleDateString("fr-FR") %></td>
            <td><%= demande.identifiant %></td>
            <td><%= demande.filiere || "-" %></td>
            <td><%= demande.niveau || "-" %></td>
            <td><%= demande.promotion || "-" %></td>
            <td class="badge 
              <%= demande.statut==='En attente' ? 'bg-info-subtle text-info' :
                  demande.statut==='Validee' ? 'bg-success-subtle text-success' :
                  demande.statut==='Rejetee' ? 'bg-danger-subtle text-danger' : '' %>">
              <%= demande.statut %>
            </td>

<td>
  <!-- Voir -->
  <a href="/demandes/<%= demande.type %>/view/<%= demande.identifiant %>"
     class="badge bg-primary-subtle text-primary rounded-3 px-1 py-1">
    <i class="bi bi-eye fs-4"></i>
  </a>

  <!-- Éditer -->
  <a href="/demandes/edit/<%= demande.type %>/<%= demande.identifiant %>"
     class="badge bg-warning-subtle text-warning rounded-3 px-1 py-1">
    <i class="bi bi-pen fs-4"></i>
  </a>

  <!-- Valider (si en attente ou rejetée) -->
   <% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
  <% if (demande.statut === "En attente" || demande.statut === "Rejetee") { %>
    <a href="/demandes/<%= demande.type %>/valider/<%= demande.identifiant %>"
       class="badge bg-success-subtle text-success rounded-3 px-1 py-1">
      <i class="bi bi-check2-circle fs-4"></i>
    </a>
  <% } %>
<% } %>
  <!-- Signer (si validée et rôle Directeur) -->

  <% if (user && user.role === "Directeur" && demande.statut === "Validee") { %>
    <a href="/demandes/<%= demande.type %>/signer/<%= demande.identifiant %>"
       class="badge bg-success-subtle text-success rounded-3 px-1 py-1">
      <i class="bi bi-file-earmark-text fs-4"></i>
    </a>
  <% } %>

  <!-- Télécharger (si signée) -->
  <% if (demande.statut === "Signee") { %>
    <a href="/demandes/<%= demande.type %>/download/<%= demande.identifiant %>"
       class="badge bg-info-subtle text-info rounded-3 px-1 py-1" download>
      <i class="bi bi-download fs-4"></i>
    </a>
  <% } %>

  <!-- Rejeter (si en attente ou validée) -->
   <% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
  <% if (demande.statut === "En attente" || demande.statut === "Validee") { %>
    <a href="/demandes/<%= demande.type %>/rejeter/<%= demande.identifiant %>"
       class="badge bg-danger-subtle text-danger rounded-3 px-1 py-1">
      <i class="bi bi-x-circle fs-4"></i>
    </a>
  <% } %>
<% } %>
  <!-- Supprimer -->
  <a class="badge bg-danger-subtle text-danger rounded-3 px-1 py-1">
    <button class="bi bi-trash fs-4 text-danger bg-danger-subtle"
            data-bs-toggle="modal"
            data-bs-target="#deleteModal-<%= demande.identifiant %>">
    </button>

    <!-- Modal de confirmation -->
    <div class="modal fade" id="deleteModal-<%= demande.identifiant %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header bg-danger text-white">
            <h5 class="modal-title">Confirmation de suppression</h5>
            <button type="button" class="btn-close btn-close-white text-primary" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <p>Voulez-vous vraiment supprimer la demande <strong><%= demande.identifiant %></strong> ?</p>
          </div>
          <div class="modal-footer">
            <button type="reset" class="btn btn-primary border-0" data-bs-dismiss="modal">Annuler</button>
            <form action="/demandes/<%= demande.type %>/delete/<%= demande.identifiant %>" method="POST">
              <button type="submit" class="btn btn-danger">Supprimer</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </a>
</td>




         
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

