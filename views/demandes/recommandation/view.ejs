<div class="container-fluid py-4">

    <%- include("../../partials/filsDAriane.ejs") %>
</div>
<div class="d-flex gap-2 justify-content-end p-2">
    <!-- Bouton Modifier -->
    <a href="/demandes/edit/recommandation/<%= recommandation.identifiant %>"
        class="badge bg-warning-subtle text-warning rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
        <i class="bi bi-pen fs-5"></i> <span class="fs-6 px-1">Modifier</span>
    </a>

    <!-- Bouton Valider (si En attente ou Rejetee) -->
    <% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
    <% if (recommandation.statut==="En attente" || recommandation.statut==="Rejetee" ) { %>
        <a href="/demandes/recommandation/valider/<%= recommandation.identifiant %>"
            class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-check2-circle fs-5"></i> <span class="fs-6 px-1">Valider</span>
        </a>
    <% } %>
    <% } %>
    <!-- Bouton Signer (pour Directeur si Validee) -->
    <% if (user && user.role==="Directeur" ) { %>
        <% if (recommandation.statut==="Validee" ) { %>
            <a href="/demandes/recommandation/signer/<%= recommandation.identifiant %>"
                class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
                <i class="bi bi-file-earmark-text fs-5"></i><span class="fs-6 px-1">Signer</span>
            </a>
        <% } %>
    <% } %>
    
    <!-- Bouton Télécharger (si Signee) -->
    <% if (recommandation.statut==="Signee" ) { %>
        <a href="/demandes/recommandation/download/<%= recommandation.identifiant %>"
            class="badge bg-info-subtle text-info rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center" download>
            <i class="bi bi-download fs-5"></i><span class="fs-6 px-1">Telecharger</span>
        </a>
    <% } %>

    <!-- Bouton Rejeter (si En attente ou Validee) -->
     <% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
    <% if (recommandation.statut==="En attente" || recommandation.statut==="Validee" ) { %>
        <a href="/demandes/recommandation/rejeter/<%= recommandation.identifiant %>"
            class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-x-circle fs-5"></i><span class="fs-6 px-1">Rejeter</span>
        </a>
    <% } %>
<% } %>
    <!-- Bouton Supprimer -->
    <div class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 d-flex align-items-center">
        <button class="btn btn-link text-danger p-0 border-0 bg-danger-subtle d-flex align-items-center" 
                style="text-decoration: none;"
                data-bs-toggle="modal" 
                data-bs-target="#deleteModal-<%= recommandation.identifiant %>">
            <i class="bi bi-trash fs-5"></i>
            <span class="fs-6 px-1 fw-bold">Supprimer</span>
        </button>
    </div>

    <!-- Modal de suppression -->
    <div class="modal fade" id="deleteModal-<%= recommandation.identifiant %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmation de suppression</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer la demande <strong><%= recommandation.identifiant %></strong> ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form action="/demandes/recommandation/delete/<%= recommandation.identifiant %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="bg-white px-4 py-4">
    <div class="row g-3">
        <div class="form-section-header border-success d-flex justify-content-between">
            <div class="">
                <h3 class="fw-bold text-primary">
                    <i class="bi bi-envelope-paper fs-1 me-2"></i>Informations sur l'étudiant
                </h3>
            </div>
        </div>

        <!-- Civilité -->
        <div class="col-md-1">
            <p class="form-label fw-semibold">Civilité :</p> 
            <span><%= recommandation.civilite %></span>
        </div>

        <!-- Nom complet -->
        <div class="col-md-3">
            <p class="form-label fw-semibold">Nom Complet :</p> 
            <span><%= recommandation.prenom %> <%= recommandation.nom %></span>
        </div>

        <!-- Filière -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Filière :</p> 
            <span><%= recommandation.filiere %></span>
        </div>

        <!-- Niveau -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Niveau :</p> 
            <span><%= recommandation.niveau %></span>
        </div>

        <!-- Promotion -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Promotion :</p> 
            <span><%= recommandation.promotion %></span>
        </div>

        <!-- Matricule -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Numéro matricule :</p> 
            <span><%= recommandation.matricule %></span>
        </div>
          <!-- Email -->
          <div class="col-md-2">
            <p class="form-label fw-semibold">Email</p> 
            <span><%= recommandation.email %></span>
        </div>
    </div>

    <hr class="mx-4">

    <div class="form-section bg-white">
        <div class="form-section-header border-success">
            <h3 class="fw-bold text-primary">
                <i class="bi bi-award fs-1 me-2"></i>Informations sur la demande de recommandation
            </h3>
        </div>

        <div class="row">
            <!-- Identifiant -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Id :</p> 
                <span><%= recommandation.identifiant %></span>
            </div>

            <!-- Type de lettre -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Type :</p> 
                <span><%= recommandation.type %></span>
            </div>

            <!-- Destinataire -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Destinataire :</p> 
                <span><%= recommandation.destinataire %></span>
            </div>

            <!-- Programme/Poste visé -->
            <div class="col-md-6 mt-3">
                <p class="form-label fw-semibold">Programme/Poste visé :</p> 
                <span><%= recommandation.programme %></span>
            </div>

            <!-- Professeur sollicité -->
            <div class="col-md-6 mt-3">
                <p class="form-label fw-semibold">Professeur sollicité :</p> 
                <span><%= recommandation.professeur %></span>
            </div>

            <!-- Note/Informations complémentaires -->
            <div class="col-md-12 mt-3">
                <p class="form-label fw-semibold">Informations complémentaires :</p> 
                <span><%= recommandation.infoSupplementaire %></span>
            </div>

            <!-- Statut -->
            <div class="col-md-12 mt-3">
                <p class="form-label fw-semibold">Statut :</p> 
                <span class="badge 
                <%= recommandation.statut==='En attente' ? 'bg-primary-subtle text-primary' 
                : recommandation.statut==='Validee' ? 'bg-success-subtle text-success' 
                : recommandation.statut==='Signee' ? 'bg-success-subtle text-success'
                : recommandation.statut==='Corigee' ? 'bg-success-subtle text-success'
                : recommandation.statut==='Rejetee' ? 'bg-danger-subtle text-danger' : '' %>">
                    <%= recommandation.statut %>
                </span>
            </div>
        </div>
    </div>
</div>
