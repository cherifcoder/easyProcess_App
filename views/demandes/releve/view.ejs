<div class="container-fluid py-4">

    <%- include("../../partials/filsDAriane.ejs") %>
</div>
<div class="d-flex gap-2 justify-content-end p-2">  <!-- réduit gap et padding -->
    <a href="/demandes/edit/releve/<%= releve.identifiant %>"
        class="badge bg-warning-subtle text-warning rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">  <!-- px-2 au lieu de px-1 -->
        <i class="bi bi-pen fs-5"></i> <span class="fs-6 px-1">Modifier</span>  <!-- fs-4 → fs-6 -->
    </a>
<% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
    <% if (releve.statut==="En attente" || releve.statut==="Rejetee" ) { %>
        <a href="/demandes/releve/valider/<%= releve.identifiant %>"
            class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-check2-circle fs-5"></i> <span class="fs-6 px-1">Valider</span>
        </a>
    <% } %>
    <% } %>
    
    <% if (user && user.role==="Directeur" ) { %>
        <% if (releve.statut==="Validee" ) { %>
            <a href="/demandes/releve/upload/<%= releve.identifiant %>"
                class="badge bg-success-subtle text-success rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
                <i class="bi-upload fs-5"></i><span class="fs-6 px-1">Uploader</span>
            </a>
        <% } %>
    <% } %>
    
    <% if (releve.statut==="Corrigee" ) { %>
        <a href="/demandes/releve/download/<%= releve.identifiant %>"
            class="badge bg-info-subtle text-info rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center" download>
            <i class="bi bi-download fs-5"></i><span class="fs-6 px-1">Telecharger</span>
        </a>
    <% } %>

    <% if (user && (user.role==="Directeur" || user.role==="Secretaire" )) { %>
    <% if (releve.statut==="En attente" || releve.statut==="Validee" ) { %>
        <a href="/demandes/releve/rejeter/<%= releve.identifiant %>"
            class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 text-decoration-none d-flex align-items-center">
            <i class="bi bi-x-circle fs-5"></i><span class="fs-6 px-1">Rejeter</span>
        </a>
    <% } %>
 <% } %>
    <div class="badge bg-danger-subtle text-danger rounded-3 px-2 py-1 d-flex align-items-center">
        <button class="btn btn-link text-danger p-0 border-0 bg-danger-subtle d-flex align-items-center" 
                style="text-decoration: none;"
                data-bs-toggle="modal" 
                data-bs-target="#deleteModal-<%= releve.identifiant %>">
            <i class="bi bi-trash fs-5"></i>
            <span class="fs-6 px-1">Supprimer</span>
        </button>
    </div>

    <!-- Modal de suppression -->
    <div class="modal fade" id="deleteModal-<%= releve.identifiant %>" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmation de suppression</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer la demande <strong><%= releve.identifiant %></strong> ?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <form action="/demandes/releve/delete/<%= releve.identifiant %>" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Supprimer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="bg-white px-4 py-4">
    <div class="row g-3">
        <div class="form-section-header border-info d-flex justify-content-between">
            <div class="">
                <h3 class="fw-bold text-primary">
                    <i class="bi bi-mortarboard-fill fs-1 me-2"></i>Informations sur l'étudiant
                </h3>
            </div>
        </div>

        <!-- Civilité -->
        <div class="col-md-1">
            <p class="form-label fw-semibold">Civilité :</p> 
            <span><%= releve.civilite %></span>
        </div>

        <!-- Nom complet -->
        <div class="col-md-3">
            <p class="form-label fw-semibold">Nom Complet :</p> 
            <span><%= releve.prenom %> <%= releve.nom %></span>
        </div>

        <!-- Filière -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Filière :</p> 
            <span><%= releve.filiere %></span>
        </div>

        <!-- Niveau -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Niveau :</p> 
            <span><%= releve.niveau %></span>
        </div>

        <!-- Promotion -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Promotion :</p> 
            <span><%= releve.promotion %></span>
        </div>

        <!-- Matricule -->
        <div class="col-md-2">
            <p class="form-label fw-semibold">Numéro matricule :</p> 
            <span><%= releve.matricule %></span>
        </div>
          <!-- Email -->
          <div class="col-md-2">
            <p class="form-label fw-semibold">Email  :</p> 
            <span><%= releve.email %></span>
        </div>
    </div>

    <hr class="mx-4">

    <div class="form-section bg-white">
        <div class="form-section-header border-info">
            <h3 class="fw-bold text-primary">
                <i class="bi bi-award fs-1 me-2"></i>Informations sur le relevé de notes
            </h3>
        </div>

        <div class="d-flex justify-content-around">
            <!-- Identifiant -->
            <div class="col-md-4">
                <p class="form-label fw-semibold">Id :</p> 
                <span><%= releve.identifiant %></span>
            </div>

            <!-- Semestre -->
            <div class="mb-4">
                <p class="form-label fw-semibold">Semestre :</p> 
                <span><%= releve.semestre %></span>
            </div>

            <!-- Statut -->
            <div class="mb-4">
                <p class="form-label fw-semibold">Statut :</p> 
                <span class="badge 
                <%= releve.statut==='En attente' ? 'bg-primary-subtle text-primary' 
                : releve.statut==='Validee' ? 'bg-success-subtle text-success' 
                : releve.statut==='Signee' ? 'bg-success-subtle text-success'
                : releve.statut==='Corigee' ? 'bg-success-subtle text-success'
                : releve.statut==='Rejetee' ? 'bg-danger-subtle text-danger' : '' %>">
                    <%= releve.statut %>
                </span>
            </div>
        </div>
    </div>
</div>
